# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel
.vercel.bak

# typescript
*.tsbuildinfo
next-env.d.ts
.playwright-mcp/
screenshots/

# 本地工具产物 / 缓存（不入库）
.pnpm-store/
.playwright-cli/

# 各类 agent 工具的本地目录
.agents/
.claude/
.codebuddy/
.qoder/
.trae/
.workbuddy/

# skills/ 下只有本项目自用的技能入库（如 wiki-content-writing）；
# 其余是指向个人 skill hub（~/.skillshub/）的符号链接 ——
# 入库后对别人是断链，且内容不属于本项目。
skills/*
!skills/wiki-content-writing/

# 本地中间产物（wiki 抓取/拆分稿/备份，不入库）
tmp/
